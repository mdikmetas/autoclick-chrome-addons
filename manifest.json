{
  "manifest_version": 3,
  "name": "Basit AutoClick",
  "version": "1.0",
  "description": "Seçtiğin noktaya istediğin hızda ve sayıda otomatik tıklar.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": { "default_popup": "popup.html", "default_title": "AutoClick" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
